NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://retailjewellerindiaforum.com
CLIENT_ORIGIN=https://retailjewellerindiaforum.com
SESSION_SECRET=generate-a-strong-random-value-of-at-least-32-characters
PASS_SIGNING_KEYS=v1:generate-a-separate-long-random-signing-key
ACTIVE_PASS_SIGNING_KEY=v1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rjif
DB_USER=rjif_app
DB_PASSWORD=replace-with-a-strong-database-password
TRUST_PROXY=1
STAGING_NOINDEX=false
UPLOAD_DIR=/srv/rjif/media
MAX_UPLOAD_MB=6
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=Retail Jeweller India Forum <no-reply@retailjewellerindiaforum.com>
FORM_NOTIFICATION_TO=team@retailjewellerindiaforum.com
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
